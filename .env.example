# GEMINI_API_KEY: Required for Gemini multimodal vision sketch analysis.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI or local .env file.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# TRIPO_API_KEY: Optional for local/offline mode; required for live cloud Tripo OpenAPI v3 image-to-3D generation.
# Obtain a developer API key (starting with tsk_) from https://platform.tripo3d.ai
# If omitted, Sketch2Shape uses its honest Local Contour-Reconstructed 3D Mesh fallback (.GLB & .OBJ/.MTL).
TRIPO_API_KEY=""

# TRIPO_MODEL_VERSION: Optional Tripo OpenAPI v3 model identifier (defaults to v3.1-20260211).
TRIPO_MODEL_VERSION="v3.1-20260211"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
